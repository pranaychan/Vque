# PostgreSQL
POSTGRES_USER=vque
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_DB=vque

# Backend security
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Frontend / CORS
FRONTEND_URL=http://localhost:5175
VITE_API_URL=http://localhost:8000

# Runtime
APP_ENV=development

# Email
# true = log that an email would be sent (no SMTP connection)
# false = use the SMTP settings below
EMAIL_DEV_MODE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# true for SMTPS/implicit TLS, normally port 465; false for STARTTLS, normally 587
SMTP_USE_SSL=false

# Allow companies to try the restaurant dashboard without creating an account
DEMO_MODE_ENABLED=true
